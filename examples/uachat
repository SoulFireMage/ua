#!/usr/bin/env python3

import getpass, io, json, os, re, select, shutil, signal, subprocess, sys, tempfile, time
import urllib.error, urllib.request
from pathlib import Path
from contextlib import suppress

try:
  import readline
except ImportError:
  readline = None

NAME = 'uachat'
CONFIG_DIR = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'ua'
CONFIG_FILE = CONFIG_DIR / 'config.json'
CACHE_FILE = CONFIG_DIR / 'models.json'
HISTORY_FILE = CONFIG_DIR / 'history'
DEFAULT_API = 'https://openrouter.ai/api/v1/responses'
DEFAULT_KEY_FILE = '~/.config/ua/key'
CACHE_TTL = 24 * 60 * 60

if sys.stdout.isatty() and not os.environ.get('NO_COLOR'):
  def sgr(code, text):
    return f'\x1b[{code}m{text}\x1b[0m'
else:
  def sgr(code, text):
    return text

def die(*args):
  print(NAME, *args, file = sys.stderr, sep = ': ')
  sys.exit(1)

def expand(path):
  return os.path.expanduser(os.path.expandvars(str(path)))

def clean_secret(text):
  text = re.sub(r'\x1b\[[0-9;?]*[ -/]*[@-~]', '', text)
  text = re.sub(r'\x1b[\[\]]', '', text)
  return re.sub(r'[\x00-\x1f\x7f]', '', text).strip()

def mask(secret):
  return f'{secret[:8]}... (length {len(secret)})' if secret else '(empty)'

def load_json(path, default):
  try:
    with open(path, 'r', encoding = 'utf-8') as stream:
      return json.load(stream)
  except (OSError, ValueError):
    return default

def save_json(path, data):
  path.parent.mkdir(parents = True, exist_ok = True)
  with open(path, 'w', encoding = 'utf-8') as stream:
    json.dump(data, stream, indent = 2)
    stream.write('\n')

def ensure_config():
  if not CONFIG_FILE.exists():
    save_json(CONFIG_FILE, {
      'api': DEFAULT_API,
      'key_file': DEFAULT_KEY_FILE,
      'model': '',
      'favorites': []
    })
  config = load_json(CONFIG_FILE, {})
  config.setdefault('api', DEFAULT_API)
  config.setdefault('key_file', DEFAULT_KEY_FILE)
  config.setdefault('model', '')
  config.setdefault('favorites', [])
  return config

def save_config(config):
  save_json(CONFIG_FILE, config)

def resolve_key(config):
  if os.environ.get('KEY'):
    return os.environ['KEY']
  if config.get('key'):
    return config['key']
  path = config.get('key_file')
  if path and Path(expand(path)).exists():
    with suppress(OSError):
      return clean_secret(Path(expand(path)).read_text(encoding = 'utf-8'))
  return None

def write_key(config, secret):
  path = Path(expand(config.get('key_file') or DEFAULT_KEY_FILE))
  path.parent.mkdir(parents = True, exist_ok = True)
  path.write_text(secret + '\n', encoding = 'utf-8')
  os.chmod(path, 0o600)
  config['key_file'] = str(path)
  save_config(config)
  print('Saved', path, '->', mask(secret))
  return path

def prompt_for_key(config):
  if not sys.stdin.isatty():
    die('no API key configured; set KEY or write one to', config.get('key_file'))
  print('No API key configured.')
  key = clean_secret(getpass.getpass('API key: '))
  if not key:
    die('aborted')
  write_key(config, key)
  return config

def set_key(config, secret = None):
  if secret is None:
    if sys.stdin.isatty():
      secret = getpass.getpass('API key: ')
    else:
      secret = sys.stdin.read()
  secret = clean_secret(secret)
  if not secret:
    die('empty key')
  write_key(config, secret)
  return secret

def ua_path():
  if os.environ.get('UA'):
    return os.environ['UA']
  here = Path(__file__).resolve().parent
  for candidate in (here / 'ua', here.parent / 'ua'):
    if candidate.exists():
      return str(candidate)
  found = shutil.which('ua')
  if found:
    return found
  die('cannot find the ua script; set UA to its path')

def child_env(config):
  env = dict(os.environ)
  env['API'] = config.get('api') or DEFAULT_API
  if key := resolve_key(config):
    env['KEY'] = key
  if config.get('model'):
    env['MODEL'] = config['model']
  if 'reasoning' in config:
    env['REASONING'] = config.get('reasoning') or ''
  for key, name in (('log', 'LOG'), ('shell', 'SHELL'), ('tools', 'TOOLS')):
    if config.get(key):
      env[name] = expand(config[key])
  return env

def run(config, action, stdin = None, capture = False):
  command = [sys.executable, ua_path(), action]
  sys.stdout.flush()
  if capture:
    process = subprocess.run(command, env = child_env(config),
      capture_output = True, text = True)
    return process.returncode, process.stdout
  if stdin is None:
    return subprocess.call(command, env = child_env(config))
  process = subprocess.run(command, env = child_env(config),
    input = stdin, text = True)
  return process.returncode

def models_url(config):
  if config.get('models_url'):
    return config['models_url']
  api = (config.get('api') or DEFAULT_API).rstrip('/')
  if api.endswith('/responses'):
    api = api[:-len('/responses')]
  return api + '/models'

def fetch_models(config):
  request = urllib.request.Request(models_url(config), headers = {
    'Accept': 'application/json', 'User-Agent': NAME
  })
  if key := resolve_key(config):
    request.add_header('Authorization', 'Bearer ' + key)
  with urllib.request.urlopen(request, timeout = 20) as stream:
    data = json.load(stream)
  rows = data.get('data', data) if isinstance(data, dict) else data
  models = []
  for row in rows or []:
    if isinstance(row, str):
      row = { 'id': row }
    if not isinstance(row, dict):
      continue
    id = row.get('id') or row.get('name')
    if not id:
      continue
    models.append({
      'id': str(id),
      'name': str(row.get('name') or id),
      'context': row.get('context_length') or row.get('context_window')
    })
  models.sort(key = lambda model: model['id'])
  return models

def get_models(config, refresh = False):
  cache = load_json(CACHE_FILE, None)
  if not refresh and cache and time.time() - cache.get('updated', 0) < CACHE_TTL:
    return cache.get('models', [])
  try:
    models = fetch_models(config)
    if models:
      save_json(CACHE_FILE, { 'updated': time.time(), 'models': models })
      return models
    raise ValueError('empty model list')
  except Exception as error:
    if cache and cache.get('models'):
      print(sgr(2, f'Using cached models ({error})'))
      return cache['models']
    die('could not fetch models:', error)

def search(models, query):
  if not query:
    return list(models)
  if len(query) > 1 and query.startswith('/') and query.endswith('/'):
    with suppress(re.error):
      pattern = re.compile(query[1:-1], re.IGNORECASE)
      return [model for model in models if pattern.search(model['id'])]
  query = query.lower()
  return [model for model in models
    if query in model['id'].lower() or query in model['name'].lower()]

def describe(model):
  context = model.get('context')
  with suppress(TypeError, ValueError):
    return f'{int(context) // 1000}k'
  return ''

def list_models(config, query = '', refresh = False):
  models = get_models(config, refresh)
  matches = search(models, query)
  if not matches:
    die('no models match', repr(query))
  for model in matches:
    context = describe(model)
    print(model['id'], sgr(2, context), sep = '\t')

def choose(config, models, query):
  matches = search(models, query)
  favorites = config.get('favorites') or []
  if not matches:
    print('No models match', repr(query))
    return None
  if not query:
    matches.sort(key = lambda model: (model['id'] not in favorites, model['id']))
  shown = matches[:40]
  for index, model in enumerate(shown, 1):
    star = '*' if model['id'] in favorites else ' '
    print(f'{star}{index:>3}) {model["id"]}', sgr(2, describe(model)), sep = '  ')
  if len(matches) > len(shown):
    print(sgr(2, f'    ... and {len(matches) - len(shown)} more; refine your filter'))
  try:
    answer = input('select # or id (empty to refine): ').strip()
  except (EOFError, KeyboardInterrupt):
    print()
    return None
  if not answer:
    return None
  if answer.isdigit() and 1 <= int(answer) <= len(shown):
    return shown[int(answer) - 1]['id']
  if any(model['id'] == answer for model in matches):
    return answer
  partial = [model['id'] for model in matches if answer.lower() in model['id'].lower()]
  if len(partial) == 1:
    return partial[0]
  return None

def pick_model(config, query = ''):
  models = get_models(config)
  if not sys.stdin.isatty():
    for model in search(models, query):
      print(model['id'])
    return None
  query = query.strip()
  while True:
    if query:
      chosen = choose(config, models, query)
      if chosen:
        break
    try:
      query = input('filter model (empty = all, /regex/ ok): ').strip()
    except (EOFError, KeyboardInterrupt):
      print()
      return None
    if not query:
      chosen = choose(config, models, '')
      if chosen:
        break
  config['model'] = chosen
  save_config(config)
  print('Model set to', sgr(1, chosen))
  return chosen

def favourite(config, model_id = ''):
  favorites = config.setdefault('favorites', [])
  if not model_id:
    for name in favorites:
      print(name)
    if not favorites:
      print('No favourite models yet; use /fav MODEL.')
    return
  if model_id in favorites:
    favorites.remove(model_id)
    print('Removed favourite', model_id)
  else:
    favorites.append(model_id)
    print('Added favourite', model_id)
  save_config(config)

def set_reasoning(config, effort = None):
  if effort is None:
    current = config.get('reasoning', None)
    print('Reasoning effort:', current if current not in (None, '') else
      ('model default' if current is None else 'disabled'))
    return
  if effort in ('default', 'unset'):
    config.pop('reasoning', None)
    print('Reasoning effort reset to model default')
  elif effort in ('none', 'off', 'disabled', ''):
    config['reasoning'] = ''
    print('Reasoning disabled')
  else:
    config['reasoning'] = effort
    print('Reasoning effort set to', effort)
  save_config(config)

def set_log(config, path = ''):
  if not path:
    print('Log file:', config.get('log') or str(Path.cwd() / 'ua.log'))
    return
  target = Path(expand(path))
  if target.is_dir():
    target = target / 'ua.log'
  target.parent.mkdir(parents = True, exist_ok = True)
  config['log'] = str(target.resolve())
  save_config(config)
  print('Log file set to', config['log'])

def doctor(config):
  print('config:    ', CONFIG_FILE)
  print('ua:        ', ua_path())
  print('python:    ', sys.version.split()[0], sys.executable)
  print('api:       ', config.get('api') or DEFAULT_API)
  print('models url:', models_url(config))
  print('model:     ', config.get('model') or '(none)')
  print('reasoning: ', config.get('reasoning', 'model default'))
  print('log:       ', config.get('log') or str(Path.cwd() / 'ua.log'))
  if os.environ.get('KEY'):
    print('key:        from $KEY', mask(clean_secret(os.environ['KEY'])))
  elif config.get('key'):
    print('key:        from config', mask(clean_secret(config['key'])))
  else:
    path = config.get('key_file')
    key = None
    if path and Path(expand(path)).exists():
      with suppress(OSError):
        key = clean_secret(Path(expand(path)).read_text(encoding = 'utf-8'))
    if key:
      print('key:        from', path, mask(key))
    else:
      print('key:        NOT SET (expected at', path, ')')
  cache = load_json(CACHE_FILE, None)
  if cache and cache.get('models'):
    age = int((time.time() - cache.get('updated', 0)) / 3600)
    print('models:    ', len(cache['models']), f'cached, {age}h old')
  else:
    print('models:     no cache; run:', NAME, 'models --refresh')

def extract_text(item):
  content = item.get('content')
  if isinstance(content, str):
    return content
  parts = []
  if isinstance(content, list):
    for part in content:
      if isinstance(part, dict):
        for kind in ('text', 'refusal'):
          if isinstance(part.get(kind), str):
            parts.append(part[kind])
  return ''.join(parts)

def history(config):
  path = Path(expand(config.get('log') or 'ua.log'))
  messages = []
  with suppress(OSError):
    with open(path, 'r', encoding = 'utf-8') as stream:
      for line in stream:
        if not (line := line.strip()):
          continue
        with suppress(ValueError):
          item = json.loads(line)
          if item.get('type') == 'message':
            text = extract_text(item).strip('\n')
            if text:
              messages.append((item.get('role') or 'system', text))
  return messages

def assistant_responses(config):
  return [text for role, text in history(config) if role == 'assistant']

def copy_text(config, text):
  for tool in ('termux-clipboard-set', 'pbcopy', 'wl-copy', 'xclip'):
    if path := shutil.which(tool):
      command = [path] + (['-selection', 'clipboard'] if tool == 'xclip' else [])
      with suppress(Exception):
        subprocess.run(command, input = text, text = True, check = True)
        return f'copied {len(text)} bytes to the clipboard with {tool}'
  log = Path(expand(config.get('log') or 'ua.log'))
  path = Path(str(log) + '.last.txt')
  with suppress(OSError):
    path.write_text(text, encoding = 'utf-8')
    return f'copied {len(text)} bytes to {path}'
  return 'could not copy the response'

def show_last(config, count = 1):
  responses = assistant_responses(config)
  if not responses:
    die('no assistant responses in', config.get('log') or 'ua.log')
  with suppress(ValueError):
    count = max(int(count), 1)
  for text in responses[-count:]:
    print(text)

def colourise_recap(text):
  lines = []
  for line in text.splitlines():
    if line.startswith('> '):
      lines.append(sgr(32, line[2:]))
    elif line.startswith('| '):
      lines.append(sgr(34, line[2:]))
    else:
      lines.append(line[2:] if line.startswith('< ') else line)
  return '\n'.join(lines) + ('\n' if text else '')

def editor_text():
  editor = os.environ.get('EDITOR') or shutil.which('nano') or shutil.which('vi')
  if not editor:
    die('no editor found; set EDITOR')
  with tempfile.NamedTemporaryFile(mode = 'w+', suffix = '.md',
      encoding = 'utf-8') as tmp:
    if subprocess.call([editor, tmp.name]) != 0:
      return ''
    tmp.seek(0)
    return tmp.read().strip('\n')

BORDER = '+' if os.environ.get('UA_ASCII') else None
if BORDER:
  TL = TR = BL = BR = '+'
  HORIZONTAL = VERTICAL = '-'
else:
  TL, TR, BL, BR = '\u256d', '\u256e', '\u2570', '\u256f'
  HORIZONTAL, VERTICAL = '\u2500', '\u2502'

def set_composer_keys():
  if readline:
    readline.parse_and_bind(r'"\C-j": "\C-v\C-j"')
    readline.parse_and_bind(r'"\e[13;2u": "\C-v\C-j"')
    readline.parse_and_bind(r'"\e\r": "\C-v\C-j"')
    readline.set_history_length(1000)

def load_history():
  if readline and HISTORY_FILE.exists():
    with suppress(Exception):
      readline.read_history_file(HISTORY_FILE)

def save_history():
  if readline:
    CONFIG_DIR.mkdir(parents = True, exist_ok = True)
    with suppress(Exception):
      readline.write_history_file(HISTORY_FILE)

def compose(config):
  width = shutil.get_terminal_size((80, 24)).columns
  label = f' {config.get("model") or "no model"} '
  bar = HORIZONTAL * max(width - len(label) - 3, 1)
  print(sgr(2, TL + HORIZONTAL + label + bar + TR))
  try:
    text = input(VERTICAL + ' ')
  except EOFError:
    print(sgr(2, BL + HORIZONTAL * max(width - 2, 1) + BR))
    return None
  print(sgr(2, BL + HORIZONTAL * max(width - 2, 1) + BR))
  return text

def banner(config):
  where = config.get('log') or str(Path.cwd() / 'ua.log')
  print(sgr(2, f'{NAME} - /help for commands, /model to switch model'))
  print(sgr(2, f'log: {where}'))
  print()

def send(config, text):
  run(config, 'user', stdin = text)

def command(config, line):
  parts = line[1:].split(None, 1)
  name = parts[0].lower() if parts else ''
  argument = parts[1].strip() if len(parts) > 1 else ''
  if name in ('q', 'quit', 'exit'):
    return True
  elif name in ('m', 'model'):
    pick_model(config, argument)
  elif name == 'models':
    refresh = argument in ('--refresh', '-r')
    list_models(config, '' if refresh else argument, refresh = refresh)
  elif name in ('r', 'reasoning'):
    set_reasoning(config, argument or None)
  elif name in ('key', 'k'):
    set_key(config, None)
  elif name == 'recap':
    _, output = run(config, 'recap', capture = True)
    sys.stdout.write(colourise_recap(output))
  elif name in ('fav', 'favorite'):
    favourite(config, argument)
  elif name == 'log':
    set_log(config, argument)
  elif name in ('edit', 'e'):
    if text := editor_text():
      send(config, text)
      run(config, 'agent')
      print()
  elif name in ('help', 'h', '?'):
    help_text()
  elif name in ('doctor', 'diag'):
    doctor(config)
  else:
    print('Unknown command', repr(name), '- try /help')

def help_text():
  print('''\
  /model [QUERY]   pick a model (saved for next time)
  /models [Q]      list matching models (/models --refresh to refetch)
  /reasoning [E]   set effort, or 'off'/'default' (no argument shows it)
  /key             replace the saved API key
  /fav [MODEL]     add/remove a favourite model
  /log [PATH]      show or set the conversation log
  /recap           print the conversation so far
  /edit            compose a message in $EDITOR
  /doctor          show paths, model, key source and cache status
  /help            this message
  /quit            leave
  Enter            send, Ctrl-J (or Shift-Enter) inserts a newline
  Ctrl-C twice     quit (once clears the line you are typing)
  Ctrl-D           quit''')

def _wrap(text, width):
  lines = []
  for paragraph in text.split('\n'):
    if not paragraph:
      lines.append('')
      continue
    current = ''
    for word in paragraph.split(' '):
      candidate = word if not current else current + ' ' + word
      if len(candidate) <= width:
        current = candidate
        continue
      if current:
        lines.append(current)
      while len(word) > width:
        lines.append(word[:width])
        word = word[width:]
      current = word
    lines.append(current)
  return lines

def _render_blocks(blocks, width):
  lines = []
  for role, text in blocks:
    if role == 'user':
      prefix, pair = '> ', 1
    elif role == 'system':
      prefix, pair = '| ', 2
    elif role == 'info':
      prefix, pair = '  ', 3
    else:
      prefix, pair = '  ', 0
    for index, line in enumerate(_wrap(text, max(width - len(prefix), 1))):
      lines.append((pair, (prefix if index == 0 else ' ' * len(prefix)) + line))
    lines.append((0, ''))
  return lines

def tui_main(stdscr, config):
  import curses

  curses.raw()
  curses.noecho()
  curses.nonl()
  stdscr.keypad(True)
  with suppress(Exception):
    curses.curs_set(1)
  with suppress(Exception):
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_BLUE, -1)
    curses.init_pair(3, curses.COLOR_YELLOW, -1)
  os.write(1, b'\x1b[?2004h')

  blocks = history(config)
  lines = ['']
  cursor_y = cursor_x = 0
  scroll = 0
  running = True

  def put(row, col, text, attr, width):
    with suppress(curses.error):
      stdscr.addnstr(row, col, text, width, attr)

  def redraw():
    nonlocal scroll
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    title = f' {NAME}  {config.get("model") or "no model"} '
    put(0, 0, title.ljust(width), curses.A_REVERSE, width)
    input_height = min(len(lines), max(1, height // 3))
    box_height = input_height + 2
    trans_top = 1
    trans_bottom = height - box_height - 2
    trans_height = max(trans_bottom - trans_top + 1, 1)
    rendered = _render_blocks(blocks, width)
    scroll = min(max(scroll, 0), max(len(rendered) - trans_height, 0))
    start = max(len(rendered) - trans_height - scroll, 0)
    for row in range(trans_height):
      index = start + row
      if index < len(rendered):
        pair, line = rendered[index]
        attr = curses.color_pair(pair) if pair else curses.A_NORMAL
        put(trans_top + row, 0, line, attr, width)
    top = height - box_height - 1
    inner = max(width - 4, 1)
    put(top, 0, TL + HORIZONTAL * (width - 2) + TR, curses.A_DIM, width)
    yoff = max(0, cursor_y - input_height + 1)
    xoff = max(0, cursor_x - inner + 1)
    for row in range(input_height):
      index = yoff + row
      text = lines[index] if index < len(lines) else ''
      put(top + 1 + row, 0,
        VERTICAL + ' ' + text[xoff:xoff + inner].ljust(inner) + ' ' + VERTICAL,
        curses.A_NORMAL, width)
    put(top + box_height - 1, 0, BL + HORIZONTAL * (width - 2) + BR,
      curses.A_DIM, width)
    hint = ' Enter send  ^J newline  ^O editor  ^Y copy  ^C clear/quit  ^D quit '
    put(height - 1, 0, hint.ljust(width - 1), curses.A_DIM, width - 1)
    with suppress(curses.error):
      stdscr.move(top + 1 + (cursor_y - yoff), min(2 + (cursor_x - xoff), width - 1))
    stdscr.refresh()

  def insert(text):
    nonlocal cursor_y, cursor_x
    for character in text:
      if character in '\r\n':
        current = lines[cursor_y]
        lines[cursor_y] = current[:cursor_x]
        lines.insert(cursor_y + 1, current[cursor_x:])
        cursor_y += 1
        cursor_x = 0
      else:
        current = lines[cursor_y]
        lines[cursor_y] = current[:cursor_x] + character + current[cursor_x:]
        cursor_x += 1

  def clear_input():
    nonlocal lines, cursor_y, cursor_x
    lines = ['']
    cursor_y = cursor_x = 0

  def backspace():
    nonlocal cursor_y, cursor_x
    if cursor_x > 0:
      current = lines[cursor_y]
      lines[cursor_y] = current[:cursor_x - 1] + current[cursor_x:]
      cursor_x -= 1
    elif cursor_y > 0:
      cursor_x = len(lines[cursor_y - 1])
      lines[cursor_y - 1] += lines[cursor_y]
      del lines[cursor_y]
      cursor_y -= 1

  def delete():
    nonlocal cursor_y
    current = lines[cursor_y]
    if cursor_x < len(current):
      lines[cursor_y] = current[:cursor_x] + current[cursor_x + 1:]
    elif cursor_y < len(lines) - 1:
      lines[cursor_y] = current + lines[cursor_y + 1]
      del lines[cursor_y + 1]

  def read_paste():
    buffer = ''
    while True:
      try:
        character = stdscr.get_wch()
      except curses.error:
        continue
      if isinstance(character, int):
        continue
      buffer += character
      if buffer.endswith('\x1b[201~'):
        return buffer[:-6]
      if len(buffer) > 100000:
        return buffer

  def read_escape():
    sequence = ''
    stdscr.timeout(50)
    while True:
      try:
        character = stdscr.get_wch()
      except curses.error:
        break
      if isinstance(character, int):
        break
      sequence += character
      if character.isalpha() or character == '~' or len(sequence) > 16:
        break
    stdscr.timeout(-1)
    if sequence == '[200~':
      return ('paste', read_paste())
    return ('esc', sequence)

  def get_event(timeout = -1):
    stdscr.timeout(timeout)
    try:
      character = stdscr.get_wch()
    except curses.error:
      return None
    if isinstance(character, str):
      if character == '\x1b':
        return read_escape()
      return ('char', character)
    return ('key', character)

  def capture(fn):
    out, err = io.StringIO(), io.StringIO()
    old_out, old_err = sys.stdout, sys.stderr
    sys.stdout, sys.stderr = out, err
    try:
      fn()
    except SystemExit:
      pass
    finally:
      sys.stdout, sys.stderr = old_out, old_err
    return (out.getvalue() + err.getvalue()).rstrip('\n')

  def suspend(fn):
    curses.def_prog_mode()
    curses.endwin()
    os.write(1, b'\x1b[?2004l')
    try:
      return fn()
    finally:
      os.write(1, b'\x1b[?2004h')
      curses.reset_prog_mode()
      stdscr.clear()
      stdscr.refresh()

  def stream():
    nonlocal scroll
    process = subprocess.Popen([sys.executable, ua_path(), 'agent'],
      env = child_env(config), stdin = subprocess.DEVNULL,
      stdout = subprocess.PIPE, stderr = subprocess.STDOUT)
    blocks.append(('assistant', ''))
    index = len(blocks) - 1
    buffer = ''
    stdscr.timeout(0)
    try:
      while True:
        if select.select([process.stdout], [], [], 0.05)[0]:
          data = os.read(process.stdout.fileno(), 4096)
          if not data:
            break
          buffer += data.decode('utf-8', 'replace')
          blocks[index] = ('assistant', buffer)
          redraw()
        elif process.poll() is not None:
          break
        elif (event := get_event(0)) and event == ('char', '\x03'):
          process.send_signal(signal.SIGINT)
          buffer += '\n[interrupted]'
          blocks[index] = ('assistant', buffer)
          redraw()
    finally:
      stdscr.timeout(-1)
      with suppress(Exception):
        process.wait(timeout = 5)
    text = buffer.strip('\n')
    if text:
      blocks[index] = ('assistant', text)
    else:
      del blocks[index]
    scroll = 0

  def submit(text):
    nonlocal scroll
    message = text.strip()
    if message.startswith('/'):
      command(message)
      return
    if message:
      blocks.append(('user', message))
      run(config, 'user', stdin = message)
    scroll = 0
    stream()

  def copy_last(argument = ''):
    responses = assistant_responses(config)
    if not responses:
      blocks.append(('info', 'No assistant response to copy yet'))
      return
    count = 1
    with suppress(ValueError):
      count = max(int(argument), 1)
    blocks.append(('info', copy_text(config, '\n\n'.join(responses[-count:]))))

  def external_editor():
    def edit():
      return editor_text()
    text = suspend(edit)
    if text:
      blocks.append(('user', text))
      run(config, 'user', stdin = text)
      stream()

  def command(text):
    nonlocal running
    parts = text[1:].split(None, 1)
    name = parts[0].lower() if parts else ''
    argument = parts[1].strip() if len(parts) > 1 else ''
    if name in ('q', 'quit', 'exit'):
      running = False
    elif name in ('m', 'model'):
      suspend(lambda: pick_model(config, argument))
    elif name == 'models':
      refresh = argument in ('--refresh', '-r')
      blocks.append(('info', capture(lambda: list_models(config,
        '' if refresh else argument, refresh = refresh)) or '(no output)'))
    elif name in ('r', 'reasoning'):
      blocks.append(('info', capture(lambda: set_reasoning(config, argument or None))))
    elif name in ('key', 'k'):
      suspend(lambda: set_key(config))
    elif name in ('fav', 'favorite'):
      blocks.append(('info', capture(lambda: favourite(config, argument))))
    elif name == 'log':
      blocks.append(('info', capture(lambda: set_log(config, argument))))
    elif name == 'recap':
      blocks[:] = history(config)
    elif name == 'copy':
      copy_last(argument)
    elif name in ('edit', 'e'):
      external_editor()
    elif name in ('doctor', 'diag'):
      blocks.append(('info', capture(lambda: doctor(config))))
    elif name in ('help', 'h', '?'):
      blocks.append(('info', 'Commands: /model /models /reasoning /key /fav /log '
        '/recap /copy /edit /doctor /quit  -  Enter sends, Ctrl-J adds a line'))
    else:
      blocks.append(('info', f'Unknown command {name!r}'))

  try:
    while running:
      redraw()
      event = get_event()
      if event is None:
        continue
      kind, value = event
      if kind == 'paste':
        insert(value)
        continue
      if kind == 'esc':
        continue
      if kind == 'key':
        if value == curses.KEY_LEFT:
          if cursor_x > 0:
            cursor_x -= 1
          elif cursor_y > 0:
            cursor_y -= 1
            cursor_x = len(lines[cursor_y])
        elif value == curses.KEY_RIGHT:
          if cursor_x < len(lines[cursor_y]):
            cursor_x += 1
          elif cursor_y < len(lines) - 1:
            cursor_y += 1
            cursor_x = 0
        elif value == curses.KEY_UP:
          if cursor_y > 0:
            cursor_y -= 1
            cursor_x = min(cursor_x, len(lines[cursor_y]))
          else:
            scroll += 1
        elif value == curses.KEY_DOWN:
          if cursor_y < len(lines) - 1:
            cursor_y += 1
            cursor_x = min(cursor_x, len(lines[cursor_y]))
          else:
            scroll = max(scroll - 1, 0)
        elif value == curses.KEY_ENTER:
          submit('\n'.join(lines))
          clear_input()
        elif value in (curses.KEY_BACKSPACE, curses.KEY_DC):
          delete() if value == curses.KEY_DC else backspace()
        elif value == curses.KEY_HOME:
          cursor_x = 0
        elif value == curses.KEY_END:
          cursor_x = len(lines[cursor_y])
        elif value == curses.KEY_PPAGE:
          scroll += 10
        elif value == curses.KEY_NPAGE:
          scroll = max(scroll - 10, 0)
        continue
      character = value
      if character == '\x03':
        if any(lines):
          clear_input()
        else:
          running = False
      elif character == '\x04':
        if any(lines):
          delete()
        else:
          running = False
      elif character == '\r':
        submit('\n'.join(lines))
        clear_input()
      elif character == '\n':
        insert('\n')
      elif character in ('\x7f', '\x08'):
        backspace()
      elif character == '\x15':
        lines[cursor_y] = ''
        cursor_x = 0
      elif character == '\x01':
        cursor_x = 0
      elif character == '\x05':
        cursor_x = len(lines[cursor_y])
      elif character == '\x0b':
        lines[cursor_y] = lines[cursor_y][:cursor_x]
      elif character == '\x0f':
        external_editor()
      elif character == '\x19':
        copy_last()
      elif character == '\x12':
        blocks[:] = history(config)
        scroll = 0
      elif character == '\t':
        insert('  ')
      elif character.isprintable():
        insert(character)
  finally:
    os.write(1, b'\x1b[?2004l')

def tui(config):
  import locale
  locale.setlocale(locale.LC_ALL, '')
  import curses
  curses.wrapper(tui_main, config)

def plain_chat(config):
  banner(config)
  load_history()
  interrupted = False
  try:
    while True:
      try:
        text = compose(config)
      except KeyboardInterrupt:
        if interrupted:
          print()
          break
        interrupted = True
        print(sgr(2, '(Ctrl-C again to quit, or Ctrl-D / /quit)'))
        continue
      interrupted = False
      if text is None:
        break
      text = text.strip()
      if not text:
        run(config, 'agent')
        print()
      elif text.startswith('/'):
        if command(config, text):
          break
      else:
        send(config, text)
        run(config, 'agent')
        print()
  finally:
    save_history()
  print()

def chat(config, plain = False):
  if not resolve_key(config):
    config = prompt_for_key(config)
  if not config.get('model'):
    if sys.stdin.isatty() and sys.stdout.isatty():
      pick_model(config)
    else:
      die('no model configured; run:', NAME, 'model')
  interactive = sys.stdin.isatty() and sys.stdout.isatty()
  if plain or os.environ.get('UA_PLAIN') or not interactive:
    plain_chat(config)
    return
  try:
    import curses
  except ImportError:
    plain_chat(config)
    return
  tui(config)

def usage():
  print(f'''\
Usage: {NAME} [ACTION] [ARGUMENT]
Actions:
  chat                 start the interactive chat loop (default)
  model [QUERY]        search for and select a model, saved to config
  models [QUERY]       list matching models (--refresh to refetch)
  reasoning [EFFORT]   set reasoning effort, 'off' or 'default'
  key                  set or replace the saved API key (prompts, or stdin)
  fav [MODEL]          toggle or list favourite models
  log [PATH]           show or set the conversation log file
  last [N]             print the last N assistant responses, raw
  copy [N]             copy the last N assistant responses to the clipboard
  config               print the configuration file path
  doctor               diagnose config, key, model and cache
  abort agent recap system user
                       run the corresponding ua action directly
Options:
  --plain              use the simple readline composer instead of the TUI
Configuration is stored in {CONFIG_FILE}.
Environment: API, KEY, MODEL, UA, EDITOR, NO_COLOR, UA_ASCII, UA_PLAIN
''', end = '', file = sys.stderr)
  sys.exit(64)

def main(argv):
  set_composer_keys()
  config = ensure_config()
  plain = '--plain' in argv
  argv = [arg for arg in argv if arg != '--plain']
  action = argv[0] if argv else 'chat'
  rest = argv[1:]
  match action:
    case 'chat':
      chat(config, plain = plain)
    case 'model':
      pick_model(config, rest[0] if rest else '')
    case 'models':
      refresh = '--refresh' in rest or '-r' in rest
      query = next((arg for arg in rest if arg not in ('--refresh', '-r')), '')
      list_models(config, query, refresh = refresh)
    case 'reasoning':
      set_reasoning(config, rest[0] if rest else None)
    case 'key':
      set_key(config)
    case 'fav' | 'favorite':
      favourite(config, rest[0] if rest else '')
    case 'log':
      set_log(config, rest[0] if rest else '')
    case 'last':
      show_last(config, rest[0] if rest else 1)
    case 'copy':
      responses = assistant_responses(config)
      if not responses:
        die('no assistant responses in', config.get('log') or 'ua.log')
      count = 1
      with suppress(ValueError):
        count = max(int(rest[0]), 1) if rest else 1
      print(copy_text(config, '\n\n'.join(responses[-count:])))
    case 'config':
      print(CONFIG_FILE)
    case 'doctor' | 'diag':
      doctor(config)
    case 'abort' | 'agent' | 'recap' | 'system' | 'user':
      sys.exit(run(config, action))
    case 'help' | '-h' | '--help':
      usage()
    case _:
      usage()

if __name__ == '__main__':
  try:
    main(sys.argv[1:])
  except KeyboardInterrupt:
    sys.exit(130)